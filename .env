# Source maps were 2.6MB of the 2.9MB deploy. The repo is public, so they
# revealed nothing, but they are dead weight on every publish.
# Set here rather than inline in the build script: an inline VAR=value prefix
# is not valid on Windows, and CRA reads this file on every platform.
GENERATE_SOURCEMAP=false

# The local ESLint cache can be locked by Windows and make production builds
# fail with EPERM. Linting is kept separate from the deploy build.
DISABLE_ESLINT_PLUGIN=true
